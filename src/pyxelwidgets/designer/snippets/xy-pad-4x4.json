{
  "format": "pyxelwidgets.snippet",
  "title": "Small XY pad",
  "doc": "CC 1 and 2 from one pad",
  "category": "Effects",
  "size": [
    4,
    4
  ],
  "widgets": [
    {
      "type": "XY",
      "name": "xy",
      "x": 0,
      "y": 0,
      "width": 4,
      "height": 4,
      "options": {}
    }
  ],
  "mappings": [
    {
      "widget": "xy",
      "on": "Changed",
      "output": "midi",
      "feedback": true,
      "message": {
        "type": "ControlChange",
        "control": 1,
        "value": {
          "source": "value_x"
        },
        "channel": 1
      }
    },
    {
      "widget": "xy",
      "on": "Changed",
      "output": "midi",
      "feedback": true,
      "message": {
        "type": "ControlChange",
        "control": 2,
        "value": {
          "source": "value_y"
        },
        "channel": 1
      }
    }
  ],
  "outputs": [
    {
      "name": "midi",
      "type": "midi_port.MidiPort",
      "virtual": "PyxelWidgets midi",
      "options": {}
    }
  ]
}
